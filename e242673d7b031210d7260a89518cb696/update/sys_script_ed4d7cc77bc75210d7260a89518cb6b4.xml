        <script><![CDATA[(function executeRule(current, previous /*null when async*/ ) {

    // Add your code here
    var gr = new GlideRecord('sn_lms_book_requests');
    if (current.state == 'requested') {
        return;
    } else if (current.state == 'approved') {
        gr.addQuery('sys_id', current.sysapproval);
        gr.query();
        if (gr.next()) {
            gr.status = 'approved';
            gr.update();
        }
    } else if (current.state == 'rejected') {
        gr.addQuery('sys_id', current.sysapproval);
        gr.query();
        if (gr.next()) {
            gr.status = 'rejected';
            gr.update();
        }
    } else if (current.state == 'completed') {
        gr.addQuery('sys_id', current.sysapproval);
        gr.query();
        if (gr.next()) {
            gr.status = 'closed';
            gr.update();
        }
    }

})(current, previous);]]></script>
